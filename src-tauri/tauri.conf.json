{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Godown Stock Register",
  "version": "1.1.0",
  "identifier": "com.godown.stockregister",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "GODOWN — Shuttering Stock Register",
        "width": 1280,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 650,
        "decorations": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/harshsoni1712/godown-stock-registery/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZCOUQyREEyNzlBOTI0RDIKUldUU0pLbDVvaTJkK3dETDIwdkg2MTBOWE5qUDZqWXhidTNVSDdHSXV1U0lOVytiK3d5M3pYdnkK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    }
  }
}
